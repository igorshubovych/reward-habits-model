<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[breed [shoppers shopper]

;; =========================================================
;; ДИНАМІЧНИЙ СТАН МОДЕЛІ
;; =========================================================

globals [
  ;; Поточна фаза експерименту:
  ;; "baseline"   — спостереження без бонусів до початку кампаній;
  ;; "reward"     — бонусна програма активна;
  ;; "withdrawal" — бонуси тимчасово або остаточно вимкнені.
  current-phase

  ;; Номер поточного бонусного циклу.
  ;; 0 означає baseline або сценарій без бонусної програми.
  current-cycle
]


;; =========================================================
;; СТАН ПОКУПЦЯ
;; =========================================================

shoppers-own [
  ;; Експериментальна група агента:
  ;; "control", "low-salience" або "high-salience".
  treatment-group

  ;; Внутрішня мотивація [0; 1].
  ;; Відображає внутрішню цінність сталого/здорового вибору для покупця,
  ;; незалежно від наявності зовнішньої винагороди.
  intrinsic-motivation

  ;; Сила звички [0; 1].
  ;; Відображає, наскільки цільовий вибір став автоматичним унаслідок
  ;; попередніх повторень.
  habit

  ;; Результат поточного вибору.
  ;; true — агент обрав цільовий сталий/здоровий товар.
  chose-target?

  ;; Лічильники потрібні для обчислення частки цільових виборів.
  ;; У repeated-сценаріях reward і withdrawal накопичуються за всі цикли.
  baseline-opportunities
  baseline-target-choices

  reward-opportunities
  reward-target-choices

  withdrawal-opportunities
  withdrawal-target-choices
]


;; =========================================================
;; ФІКСОВАНІ ПРИПУЩЕННЯ МОДЕЛІ
;; =========================================================
;;
;; Ці reporters виконують роль іменованих констант. Вони не є станом
;; моделі та не змінюються під час симуляції. Така форма робить формули
;; читабельними, але не перевантажує globals внутрішніми змінними.

;; Тривалість початкового спостереження без бонусів, у ticks.
to-report baseline-duration
  report 30
end

;; Початковий середній рівень внутрішньої мотивації у популяції.
to-report initial-intrinsic-mean
  report 0.50
end

;; Стандартне відхилення початкової внутрішньої мотивації.
to-report initial-intrinsic-sd
  report 0.15
end

;; Початковий середній рівень сформованої звички.
to-report initial-habit-mean
  report 0.20
end

;; Стандартне відхилення початкової сили звички.
to-report initial-habit-sd
  report 0.10
end

;; Вага внутрішньої мотивації у функції корисності цільового вибору.
to-report intrinsic-choice-weight
  report 3
end

;; Вага звички у функції корисності цільового вибору.
to-report habit-choice-weight
  report 1.5
end

;; Вага зовнішньої винагороди у функції корисності цільового вибору.
to-report reward-choice-weight
  report 2
end

;; Відносна "вартість" або бар'єр цільового вибору.
;; Це може інтерпретуватися як вища ціна, менша зручність або інше
;; зусилля, необхідне для сталого/здорового вибору.
to-report target-choice-cost
  report 1.5
end

;; Поріг психологічної помітності винагороди.
;; Нижче порога винагорода трактується як підтримувальна;
;; вище порога — як контролююча, що може витісняти мотивацію.
to-report salience-threshold
  report 0.60
end

;; Швидкість природного послаблення звички, якщо цільовий вибір
;; не повторився у поточному tick.
to-report habit-decay-rate
  report 0.01
end

;; Невелика фіксована швидкість підсилення intrinsic motivation
;; для підтримувальної low-salience винагороди.
to-report intrinsic-reinforcement-rate
  report 0.005
end


;; =========================================================
;; ФІЗИЧНИЙ / ПОВЕДІНКОВИЙ ЗМІСТ UI-ПАРАМЕТРІВ
;; =========================================================
;;
;; number-of-shoppers
;;   Розмір модельованої популяції покупців.
;;
;; reward-duration
;;   Кількість послідовних ticks, протягом яких бонуси активні
;;   в кожному бонусному циклі.
;;
;; withdrawal-duration
;;   Кількість ticks без бонусів після кожного reward-періоду.
;;   Для repeated-сценарію це пауза між кампаніями, а після останнього
;;   циклу — фінальний період спостереження за стійкістю поведінки.
;;
;; reward-cycles
;;   Кількість повторень послідовності reward -> withdrawal.
;;   0 — бонусна програма не застосовується;
;;   1 — одна бонусна кампанія;
;;   >1 — кілька бонусних кампаній із паузами між ними.
;;
;; low-reward / high-reward
;;   Психологічна salience винагороди, а не грошова сума напряму.
;;   Чим вище значення, тим помітнішою і сильнішою є зовнішня причина
;;   зробити цільовий вибір.
;;
;; habit-learning-rate
;;   Швидкість перетворення повторюваної цільової поведінки на звичку.
;;
;; crowding-out-rate
;;   Швидкість ерозії intrinsic motivation, коли salience винагороди
;;   перевищує salience-threshold.


;; =========================================================
;; SETUP
;; =========================================================

to setup
  clear-all

  setup-shoppers

  reset-ticks
  update-experiment-state
  update-visualization
end


to setup-shoppers
  create-shoppers number-of-shoppers [
    initialize-shopper
    assign-treatment-group
  ]
end


to initialize-shopper
  set shape "person"
  set size 0.7

  ;; Гетерогенність популяції задається обрізаним нормальним розподілом.
  set intrinsic-motivation bounded-random-normal
    initial-intrinsic-mean
    initial-intrinsic-sd
    0
    1

  set habit bounded-random-normal
    initial-habit-mean
    initial-habit-sd
    0
    1

  set chose-target? false

  set baseline-opportunities 0
  set baseline-target-choices 0

  set reward-opportunities 0
  set reward-target-choices 0

  set withdrawal-opportunities 0
  set withdrawal-target-choices 0
end


to assign-treatment-group
  ;; Детермінований рівномірний розподіл мінімізує випадкову різницю
  ;; у розмірах трьох експериментальних груп.
  if who mod 3 = 0 [
    set treatment-group "control"
    set color (lime - 3)
  ]

  if who mod 3 = 1 [
    set treatment-group "low-salience"
    set color cyan
  ]

  if who mod 3 = 2 [
    set treatment-group "high-salience"
    set color red
  ]
end


;; =========================================================
;; ЧАСОВА СТРУКТУРА ЕКСПЕРИМЕНТУ
;; =========================================================

;; Загальна тривалість симуляції.
;; Кожен reward-цикл складається з активного бонусного періоду
;; та наступного withdrawal-періоду. Тому останній цикл автоматично
;; містить фінальний період спостереження після скасування бонусів.
to-report experiment-end
  if reward-cycles <= 0 [
    report baseline-duration + withdrawal-duration
  ]

  report baseline-duration
    + reward-cycles * (reward-duration + withdrawal-duration)
end


;; Визначає фазу для довільного tick без зберігання reward-start/reward-end.
to-report phase-at [time]
  if time < baseline-duration [
    report "baseline"
  ]

  ;; Сценарій reward-cycles = 0 моделює повну відсутність бонусної
  ;; програми; після baseline триває контрольний withdrawal-період.
  if reward-cycles <= 0 [
    report "withdrawal"
  ]

  let elapsed time - baseline-duration
  let cycle-length reward-duration + withdrawal-duration
  let position-in-cycle elapsed mod cycle-length

  if position-in-cycle < reward-duration [
    report "reward"
  ]

  report "withdrawal"
end


;; Повертає номер reward-циклу для інтерфейсу та майбутніх метрик.
to-report cycle-at [time]
  if time < baseline-duration or reward-cycles <= 0 [
    report 0
  ]

  let elapsed time - baseline-duration
  let cycle-length reward-duration + withdrawal-duration
  let cycle-number 1 + floor (elapsed / cycle-length)

  report min list reward-cycles cycle-number
end


to update-experiment-state
  set current-phase phase-at ticks
  set current-cycle cycle-at ticks
end


;; =========================================================
;; MAIN LOOP
;; =========================================================

to go
  if ticks >= experiment-end [
    stop
  ]

  update-experiment-state

  ask shoppers [
    shopper-step
  ]

  update-visualization
  tick
end


;; =========================================================
;; ПОВЕДІНКА ПОКУПЦЯ
;; =========================================================

to shopper-step
  make-choice
  record-choice
  update-habit
  update-intrinsic-motivation
end


to make-choice
  ;; Вибір стохастичний: utility визначає ймовірність, а не жорсткий
  ;; детермінований результат.
  set chose-target?
    random-float 1 < target-choice-probability
end


to-report target-choice-probability
  let utility
    intrinsic-choice-weight * intrinsic-motivation
    + habit-choice-weight * habit
    + current-reward-effect
    - target-choice-cost

  report logistic utility
end


;; Поточний прямий вплив бонусу на вибір.
;; Він існує лише у reward-фазі та лише для treatment-груп.
to-report current-reward-effect
  if current-phase != "reward" or treatment-group = "control" [
    report 0
  ]

  report reward-choice-weight * reward-salience
end


;; Salience визначається експериментальною групою.
to-report reward-salience
  if treatment-group = "low-salience" [
    report low-reward
  ]

  if treatment-group = "high-salience" [
    report high-reward
  ]

  report 0
end


;; =========================================================
;; ФОРМУВАННЯ ЗВИЧКИ
;; =========================================================

to update-habit
  ifelse chose-target? [
    ;; Звичка формується швидше, коли:
    ;; 1) цільовий вибір повторюється;
    ;; 2) внутрішня мотивація вища;
    ;; 3) під час reward-фази присутня додаткова зовнішня підтримка.
    ;; Множник (1 - habit) створює насичення біля верхньої межі 1.
    let reward-bonus 0

    if current-phase = "reward" [
      set reward-bonus reward-salience
    ]

    let habit-gain
      habit-learning-rate
      * (1 + intrinsic-motivation + reward-bonus)
      * (1 - habit)

    set habit clamp (habit + habit-gain) 0 1
  ]
  [
    ;; Без повторення цільової поведінки звичка повільно згасає.
    set habit clamp (habit - habit-decay-rate) 0 1
  ]
end


;; =========================================================
;; ВНУТРІШНЯ МОТИВАЦІЯ
;; =========================================================

to update-intrinsic-motivation
  ;; Зовнішня винагорода змінює intrinsic motivation лише тоді, коли:
  ;; - бонусна програма активна;
  ;; - агент належить до treatment-групи;
  ;; - агент фактично зробив цільовий вибір.
  if current-phase != "reward" [ stop ]
  if treatment-group = "control" [ stop ]
  if not chose-target? [ stop ]

  let salience reward-salience

  ifelse salience <= salience-threshold [
    ;; Підтримувальна винагорода може підтверджувати цінність поведінки.
    ;; Зростання сповільнюється, коли motivation наближається до 1.
    let reinforcement
      intrinsic-reinforcement-rate
      * (salience-threshold - salience + 0.1)
      * (1 - intrinsic-motivation)

    set intrinsic-motivation
      clamp (intrinsic-motivation + reinforcement) 0 1
  ]
  [
    ;; Контролююча high-salience винагорода може витісняти внутрішню
    ;; мотивацію. Втрата пропорційна перевищенню порога, параметру
    ;; crowding-out-rate та наявному запасу intrinsic motivation.
    let motivation-loss
      crowding-out-rate
      * (salience - salience-threshold)
      * intrinsic-motivation

    set intrinsic-motivation
      clamp (intrinsic-motivation - motivation-loss) 0 1
  ]
end


;; =========================================================
;; ЗБІР РЕЗУЛЬТАТІВ
;; =========================================================

to record-choice
  ;; Лічильники reward/withdrawal агрегують усі відповідні фази
  ;; у repeated-сценарії. Це зберігає сумісність існуючих метрик.
  if current-phase = "baseline" [
    set baseline-opportunities baseline-opportunities + 1
    if chose-target? [
      set baseline-target-choices baseline-target-choices + 1
    ]
  ]

  if current-phase = "reward" [
    set reward-opportunities reward-opportunities + 1
    if chose-target? [
      set reward-target-choices reward-target-choices + 1
    ]
  ]

  if current-phase = "withdrawal" [
    set withdrawal-opportunities withdrawal-opportunities + 1
    if chose-target? [
      set withdrawal-target-choices withdrawal-target-choices + 1
    ]
  ]
end


;; =========================================================
;; ВІЗУАЛІЗАЦІЯ
;; =========================================================

to update-visualization
  ask shoppers [
    ;; X = intrinsic motivation, Y = habit strength.
    ;; Тому рух агента праворуч означає вищу внутрішню мотивацію,
    ;; а рух угору — сильнішу звичку.
    let x-position scale-value intrinsic-motivation min-pxcor max-pxcor
    let y-position scale-value habit min-pycor max-pycor

    ;; Невеликий jitter зменшує повне накладання агентів.
    set x-position x-position + random-float 0.3 - 0.15
    set y-position y-position + random-float 0.3 - 0.15

    setxy
      clamp x-position min-pxcor max-pxcor
      clamp y-position min-pycor max-pycor

    ifelse chose-target? [
      set size 1
    ]
    [
      set size 0.55
    ]
  ]
end


to-report scale-value [value minimum maximum]
  report minimum + value * (maximum - minimum)
end


;; =========================================================
;; МЕТРИКИ
;; =========================================================

;; Частка цільових виборів заданої групи у заданому типі фази.
;; Для repeated-сценарію reward/withdrawal — агреговані за всі цикли.
to-report choice-rate [group-name phase-name]
  let selected-shoppers shoppers with [
    treatment-group = group-name
  ]

  if not any? selected-shoppers [
    report 0
  ]

  if phase-name = "baseline" [
    report safe-rate
      (sum [baseline-target-choices] of selected-shoppers)
      (sum [baseline-opportunities] of selected-shoppers)
  ]

  if phase-name = "reward" [
    report safe-rate
      (sum [reward-target-choices] of selected-shoppers)
      (sum [reward-opportunities] of selected-shoppers)
  ]

  if phase-name = "withdrawal" [
    report safe-rate
      (sum [withdrawal-target-choices] of selected-shoppers)
      (sum [withdrawal-opportunities] of selected-shoppers)
  ]

  report 0
end


to-report mean-intrinsic-motivation [group-name]
  let selected-shoppers shoppers with [
    treatment-group = group-name
  ]

  if not any? selected-shoppers [ report 0 ]
  report mean [intrinsic-motivation] of selected-shoppers
end


to-report mean-habit [group-name]
  let selected-shoppers shoppers with [
    treatment-group = group-name
  ]

  if not any? selected-shoppers [ report 0 ]
  report mean [habit] of selected-shoppers
end


;; Різниця withdrawal choice rate між high-salience і control.
;; Від'ємне значення інтерпретується як crowding-out.
to-report high-reward-crowding-out-effect
  report
    choice-rate "high-salience" "withdrawal"
    - choice-rate "control" "withdrawal"
end


;; Різниця withdrawal choice rate між low-salience і control.
;; Додатне значення означає довготривалий позитивний ефект.
to-report low-reward-persistence-effect
  report
    choice-rate "low-salience" "withdrawal"
    - choice-rate "control" "withdrawal"
end


;; Загальна реалізація падіння після скасування винагороди.
to-report withdrawal-drop [group-name]
  report
    choice-rate group-name "reward"
    - choice-rate group-name "withdrawal"
end


to-report high-reward-withdrawal-drop
  report withdrawal-drop "high-salience"
end


to-report low-reward-withdrawal-drop
  report withdrawal-drop "low-salience"
end


;; Частка reward-phase поведінки, яка збереглась у withdrawal-фазах.
to-report retention-ratio [group-name]
  let during-rate choice-rate group-name "reward"

  if during-rate = 0 [ report 0 ]
  report choice-rate group-name "withdrawal" / during-rate
end


to-report high-reward-retention-ratio
  report retention-ratio "high-salience"
end


to-report low-reward-retention-ratio
  report retention-ratio "low-salience"
end



;; =========================================================
;; ДОПОМІЖНІ REPORTERS
;; =========================================================

to-report safe-rate [numerator denominator]
  if denominator = 0 [ report 0 ]
  report numerator / denominator
end


to-report logistic [value]
  ;; Обмеження аргументу запобігає переповненню exp().
  let bounded-value clamp value -20 20
  report 1 / (1 + exp (- bounded-value))
end


to-report clamp [value minimum maximum]
  report max list minimum (min list maximum value)
end


to-report bounded-random-normal
  [mean-value deviation minimum maximum]

  report clamp
    (random-normal mean-value deviation)
    minimum
    maximum
end
]]></code>
  <widgets>
    <view x="460" wrappingAllowedX="true" y="20" frameRate="30.0" minPycor="-16" height="539" showTickCounter="true" patchSize="16.21212121212121" fontSize="10" wrappingAllowedY="true" width="539" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <button x="100" y="30" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <slider x="30" step="5" y="135" max="200" display="reward-duration" height="33" min="10" direction="Horizontal" default="60.0" variable="reward-duration" width="175" sizeVersion="0"></slider>
    <slider x="120" step="100" y="90" max="3000" display="number-of-shoppers" height="33" min="300" direction="Horizontal" default="1000.0" variable="number-of-shoppers" width="175" sizeVersion="0"></slider>
    <plot x="1010" autoPlotX="true" yMax="1.0" autoPlotY="true" y="5" xMin="0.0" height="220" legend="true" xMax="0.0" yMin="0.0" width="390" xAxis="Baseline  █ Reward  █████ Withdrawal ███" display="Target choice rate">
