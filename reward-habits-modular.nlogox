] / count shoppers with [
  treatment-group = "high-salience"
]</update>
      </pen>
    </plot>
    <plot x="1010" autoPlotX="true" yMax="1.0" autoPlotY="false" y="235" xMin="0.0" height="185" legend="true" xMax="160.0" yMin="0.0" width="390" display="Mean Intrinsic Motivation">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Control" color="-15575016" legend="true">
        <setup></setup>
        <update>plotxy ticks mean [intrinsic-motivation] of shoppers with [
    treatment-group = "control"
]</update>
      </pen>
      <pen interval="1.0" mode="0" display="Low salience" color="-11221820" legend="true">
        <setup></setup>
        <update>plotxy ticks mean [intrinsic-motivation] of shoppers with [
    treatment-group = "low-salience"
]</update>
      </pen>
      <pen interval="1.0" mode="0" display="High salience" color="-2674135" legend="true">
        <setup></setup>
        <update>plotxy ticks mean [intrinsic-motivation] of shoppers with [
    treatment-group = "high-salience"
]</update>
      </pen>
    </plot>
    <plot x="1010" autoPlotX="true" yMax="1.0" autoPlotY="false" y="425" xMin="0.0" height="195" legend="true" xMax="160.0" yMin="0.0" width="390" display="Mean Habit Strength">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Control" color="-15575016" legend="true">
        <setup></setup>
        <update>plotxy ticks mean [habit] of shoppers with [
    treatment-group = "control"
]</update>
      </pen>
      <pen interval="1.0" mode="0" display="Low salience" color="-11221820" legend="true">
        <setup></setup>
        <update>plotxy ticks mean [habit] of shoppers with [
    treatment-group = "low-salience"
]</update>
      </pen>
      <pen interval="1.0" mode="0" display="High salience" color="-2674135" legend="true">
        <setup></setup>
        <update>plotxy ticks mean [habit] of shoppers with [
    treatment-group = "high-salience"
]</update>
      </pen>
    </plot>
